[Unit]
Description=Run audio_control.py on boot
After=network.target sound.target  # 确保音频设备就绪

[Service]
Type=simple
User=gdw  # 必须指定为您的用户名
Group=gdw  # 用户组
WorkingDirectory=/home/gdw/nlu/intentslot  # 设置工作目录
Environment="PATH=/home/gdw/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"  # 显式传递PATH
Environment="CONDA_PREFIX=/home/gdw/miniconda3"  # 若依赖conda环境
ExecStart=/home/gdw/miniconda3/bin/python /home/gdw/nlu/intentslot/main.py
Restart=on-failure  # 失败时自动重启

[Install]
WantedBy=multi-user.target
